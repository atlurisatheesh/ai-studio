# ── Required ────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Auth ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@arcvox.ai
# Leave empty to auto-generate a random admin password (printed once in logs)
ADMIN_PASSWORD=

# ── Network ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8001

# ── Production hardening ────────────────────────────────────────────────
# Max size (MB) for any single uploaded file (audio sample / portrait / clip)
MAX_UPLOAD_MB=50
# Auto-purge generated TTS/avatar outputs older than this many hours (0 = off)
OUTPUT_TTL_HOURS=48
# Per-IP request cap per minute (0 = off). For multi-worker, use a real gateway.
RATE_LIMIT_PER_MINUTE=120

# ── Speech-to-text accuracy ladder ──────────────────────────────────────
# tiny | base | small | medium | large-v3
# large-v3 on GPU = matches/beats commercial transcription accuracy
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# ── Text-to-speech ──────────────────────────────────────────────────────
# auto         = Chatterbox if installed (GPU, HD + cloning, 23 langs incl Hindi), else Piper (CPU)
# chatterbox   = force Chatterbox (HD + zero-shot cloning)
# indic_parler = AI4Bharat Indic Parler-TTS — 21 languages incl. all major Indian
#                ones (Tamil/Telugu/Bengali/Marathi/…), Apache-2.0. Gated model:
#                accept terms at hf.co/ai4bharat/indic-parler-tts, then set HF_TOKEN.
# multi        = ONE deployment, auto-routed per request by the text's script:
#                Indian scripts → Indic Parler, everything else → Chatterbox,
#                voice cloning always → Chatterbox. (Needs both engines installed.)
# piper        = CPU fallback, English-led, no cloning
TTS_ENGINE=auto
# Hugging Face token (only needed for the gated Indic Parler-TTS model)
HF_TOKEN=

# ── LLM provider ────────────────────────────────────────────────────────
# ollama  -> fully local, requires Ollama + a pulled model (default)
# grok    -> xAI Grok API (only text prompts cross the wire; all audio/video stays local)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b

# Grok / xAI (used when LLM_PROVIDER=grok)
GROK_API_KEY=
# grok-3-mini (fast, cheap) | grok-3 (most capable) | grok-beta
GROK_MODEL=grok-3-mini

# ── Avatar lipsync (Phase 2, GPU host) ──────────────────────────────────
# none         -> portrait + narrated audio preview (CPU-only, no motion)
# sadtalker    -> one photo -> talking head (~8GB VRAM, fastest to set up)
# musetalk     -> higher fidelity than SadTalker (~12GB VRAM)
# echomimic    -> near-photorealistic audio-driven lipsync (~16GB VRAM)  <- recommended on high-end GPU
# liveportrait -> high-fidelity face reenactment with audio driving (~8GB VRAM)
#                 requires a LivePortrait fork that supports --driving_audio
#                 e.g. https://github.com/FurkanGozukara/LivePortrait
AVATAR_ENGINE=none
SADTALKER_DIR=
MUSETALK_DIR=
ECHOMIMIC_DIR=
LIVEPORTRAIT_DIR=
AVATAR_PYTHON=python3
