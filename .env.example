# ── Required ────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Auth ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@arcvox.ai
# Leave empty to auto-generate a random admin password (printed once in logs)
ADMIN_PASSWORD=

# ── Network ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8001

# ── Speech-to-text accuracy ladder ──────────────────────────────────────
# tiny | base | small | medium | large-v3
# large-v3 on GPU = matches/beats commercial transcription accuracy
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# ── Text-to-speech ──────────────────────────────────────────────────────
# auto = Chatterbox if installed (GPU, HD + cloning), else Piper (CPU)
TTS_ENGINE=auto

# ── Local LLM ───────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b

# ── Avatar lipsync (Phase 2, GPU host) ──────────────────────────────────
# none         -> portrait + narrated audio preview (CPU-only, no motion)
# sadtalker    -> one photo -> talking head (~8GB VRAM, fastest to set up)
# musetalk     -> higher fidelity than SadTalker (~12GB VRAM)
# echomimic    -> near-photorealistic audio-driven lipsync (~16GB VRAM)  <- recommended on high-end GPU
# liveportrait -> high-fidelity face reenactment with audio driving (~8GB VRAM)
#                 requires a LivePortrait fork that supports --driving_audio
#                 e.g. https://github.com/FurkanGozukara/LivePortrait
AVATAR_ENGINE=none
SADTALKER_DIR=
MUSETALK_DIR=
ECHOMIMIC_DIR=
LIVEPORTRAIT_DIR=
AVATAR_PYTHON=python3
